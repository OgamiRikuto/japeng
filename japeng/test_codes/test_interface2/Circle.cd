class Circle based Shape:
    radius: Integer;

    init: Function is [
        arg p: Point, r: Integer;
        super init(p);
        radius is r;
    ];

    draw: Function is [
        "{self toString}" print;
        super draw;
    ];

    toString: Function is [
        ret String;
        return "半径:{radius}, 中心:{p toString}の円";
    ];
