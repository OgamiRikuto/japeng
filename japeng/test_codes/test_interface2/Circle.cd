class Circle based Shape:
    radius: Integer;

    init: Function = [
        arg p: Point, r: Integer;
        super.init(p);
        radius = r;
    ];

    draw: Function = [
        "{self.toString}".print;
        super.draw;
    ];

    toString: Function = [
        ret String;
        return "半径:{radius}, 中心:{p.toString}の円";
    ];
