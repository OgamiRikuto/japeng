class Triangle based Shape:
    p2: Point;
    p3: Point;

    init: Function = [
        arg p1: Point, _p2: Point, _p3: Point;
        super.init(p1);
        p2 = _p2;
        p3 = _p3;
    ];

    draw: Function = [
        "{self.toString}".print;
        super.draw;
    ];

    toString: Function = [
        ret String;
        return "頂点1:{p.toString}, 頂点2:{p2.toString}, 頂点3:{p3.toString}の三角形";
    ];
