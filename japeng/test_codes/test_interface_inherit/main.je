f: FiLe = FiLe("test.txt");

// 1. ReadWriter としての呼び出し
rw: ReadWriter = f;
rw.flush; // -> "バッファをフラッシュしました。"

// 2. 親インターフェース Reader へのアップキャスト
r: Reader = f;
msg: String = r.read;
msg.println; // -> "ファイル内容の読み込み成功"

// 3. 親インターフェース Writer へのアップキャスト
w: Writer = f;
w.write("Hello JapEng!"); // -> "書き込み中: Hello JapEng!"

return 0;
