class FiLe implements ReadWriter:
    path: String;

    init: Function = [
        arg p: String;
        path = p;
    ];

    read: Function = [
        ret String;
        return "ファイル内容の読み込み成功";
    ];

    write: Function = [
        arg text: String;
        "書き込み中: ".print;
        text.println;
    ];

    flush: Function = [
        "バッファをフラッシュしました。".println;
    ];

