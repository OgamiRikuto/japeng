class File implements ReadWriter:
    path: String;

    init: Function is [
        arg p: String;
        path is p;
    ];

    read: Function is [
        ret String;
        return "ファイル内容の読み込み成功";
    ];

    write: Function is [
        arg text: String;
        "書き込み中: " print;
        text println;
    ];

    flush: Function is [
        "バッファをフラッシュしました。" println;
    ];

