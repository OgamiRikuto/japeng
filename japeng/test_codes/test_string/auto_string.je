// 1. 基本的な変数展開
name: String = "JapEng";
version: Integer = 2;
s1: String = "Welcome to {name} v{version}!";
s1.println;

// 2. 式のインライン計算
a: Integer = 15;
b: Integer = 27;
"Calc: {a} + {b} = {a + b}".println;

// 3. 配列添字アクセスとの組み合わせ
list: List Integer = 100, 200, 300;
"Array access: first={list[0]}, second={list[1]}, sum={list[0] + list[2]}".println;

// 4. 各種ビルトイン型の toString 挙動
flag_t: Boolean = true;
flag_f: Boolean = false;
f_val: Float = 3.14;
"Types: bool=({flag_t}, {flag_f}), float={f_val}, list={list}".println;

// 5. エスケープシーケンス (\{, \", \n)
"Escape test: \{escaped\} and \"quoted\" and \n[new line]".println;

// 6. ネストした文字列表現
msg: String = "Result: {"nested".toString}";
msg.println;

return 0;
