// 1. 真理値リテラルと型
真偽値: 論理型 = 真;
偽値: 論理型 = 偽;

真偽値を行出力;
偽値を行出力;

もし (真偽値) なら [
    "真理値分岐: OK"を行出力;
];

// 2. 空（null）と自動インスタンス
対象1: ノード型 = 無;
対象2: ノード型;

もし (対象1 == 無) なら[
    "対象1は空: OK"を行出力;
];

もし (対象2 != 無) なら[
    "対象2は空ではない: OK"を行出力;
];

// 3. 無型（Void）と返値（return）
挨拶: 関数型 = [
    返す型 無型;
    "無型関数からの出力: OK"を行出力;
    返り値;
];

自身が挨拶;
