// 1. 真理値リテラルと型
真偽値: 論理型 = 真;
偽値: 論理型 = 偽;

真偽値.行出力;
偽値.行出力;

もし (真偽値) [
    "真理値分岐: OK".行出力;
];

// 2. 空（null）と自動インスタンス
対象1: ノード型 = 無;
対象2: ノード型;

もし (対象1 == 無) [
    "対象1は空: OK".行出力;
];

もし (対象2 != 無) [
    "対象2は空ではない: OK".行出力;
];

// 3. 無型（Void）と返値（return）
挨拶: 関数型 = [
    返す型 無型;
    "無型関数からの出力: OK".行出力;
    返値;
];

自身.挨拶;
