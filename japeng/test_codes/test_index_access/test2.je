row1: List Integer = 10, 20;
row2: List Integer = 30, 40;

// 2. 行を詰めて 2次元配列を作成
arr: List (List Integer) = row1, row2;
a: Integer = 1;

// 3. 二次元添字アクセス！
arr[0][0].println; // 10
arr[0][1].println; // 20
arr[a][a - 1].println; // 30
arr[a][a].println; // 40

// 4. 二次元要素の書き換え
arr[0][1] = 99;
arr[0][1].println; // 99

return 0;
