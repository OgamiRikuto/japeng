a: Fraction is Fraction(1, 2);
b: Fraction is Fraction(1, 3);

// 1/2 + 1/3 = 5/6
c: Fraction is a + b;
c toString .println;

// 1/2 * 2/3 = 1/3 (自動で約分される！)
d: Fraction is a * Fraction(2, 3);
d toString.println;

// 3 / -4 -> -3/4 (符号が正しく整流される！)
e: Fraction is Fraction(3, -4);
e toString . println;

return 0;
