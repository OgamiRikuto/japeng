a: Fraction = Fraction(1, 2);
b: Fraction = Fraction(1, 3);

// 1/2 + 1/3 = 5/6
c: Fraction = a + b;
c.toString.println;

// 1/2 * 2/3 = 1/3 (自動で約分される！)
d: Fraction = a * Fraction(2, 3);
d.toString.println;

// 3 / -4 -> -3/4 (符号が正しく整流される！)
e: Fraction = Fraction(3, -4);
e.toString.println;

return 0;
