クラス 飼い主型:
    名前: 文字列型;
    愛犬: 犬型;

    初期化: 関数型 = [
        引数 _名前: 文字列型, _愛犬: 犬型;
        名前 = _名前;
        愛犬 = _愛犬;
    ];

    // 助詞を含む識別子
    犬の世話をする: 関数型 = [
        返す型 文字列型;
        愛犬. ご褒美を食べる ;
        返値は愛犬.鳴く;
    ];

    愛犬の誕生日を祝う: 関数型 = [
        返す型 飼い主型;
        愛犬. 年齢の加算 ;
        返値は自身;
    ];
