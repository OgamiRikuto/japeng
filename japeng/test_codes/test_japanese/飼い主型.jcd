クラス 飼い主型:
    名前: 文字列型;
    愛犬: 犬型;

    初期化: 関数型 = [
        引数 _名前: 文字列型, _愛犬: 犬型;
        名前 = _名前;
        愛犬 = _愛犬;
    ];

    // 助詞を含む識別子
    世話: 関数型 = [
        返す型 文字列型;
        愛犬がご褒美取得 ;
        返り値 愛犬が鳴く;
    ];

    誕生日祝福: 関数型 = [
        返す型 飼い主型;
        愛犬の年齢加算 ;
        返り値は自身;
    ];
