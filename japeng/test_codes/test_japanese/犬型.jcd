クラス 犬型:
    名前: 文字列型;
    年齢: 整数型;
    機嫌: 文字列型;

    初期化: 関数型は [
        引数 _名前: 文字列型, _年齢: 整数型;
        名前は_名前;
        年齢は_年齢;
        機嫌は "普通";
    ];

    鳴く: 関数型は [
        返す型 文字列型;
        もし (機嫌 = "最高") なら [
            返値は "わんわん！（大喜び）";
        ];
        返値は "わん";
    ];

    // 助詞を含む識別子
    ご褒美を食べる: 関数型は [
        返す型 犬型;
        機嫌は "最高";
        返値は自身;
    ];

    年齢の加算: 関数型は [
        返す型 犬型;
        年齢 += 1;
        返値は自身;
    ];
