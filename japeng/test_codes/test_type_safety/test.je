// =============================================================================
// JapEng 型システム・引数検査 厳格性ストレステスト
// =============================================================================

// -----------------------------------------------------------------------------
// 【実験 1】条件式の非 Boolean 許容（条件式の型チェック抜け）
// 期待される挙動: 「条件式には真偽値型 (Boolean) が必要です」でコンパイル停止
// -----------------------------------------------------------------------------
if ("文字列") [
    "通ってしまった" println;
];

if (100) [
    "通ってしまった" println;
];


// -----------------------------------------------------------------------------
// 【実験 2】異型ジェネリクス代入（型引数の照合スルー）
// 期待される挙動: List String に List Integer は代入不可
// -----------------------------------------------------------------------------
int_list: List Integer are 1, 2, 3;
str_list: List String is int_list; // 型引数 (Integer vs String) を無視して通らないか？


// -----------------------------------------------------------------------------
// 【実験 3】二項演算（ビット演算）の異型チェック
// 期待される挙動: 整数型同士以外はコンパイルエラー
// -----------------------------------------------------------------------------
bad_calc1: Integer is 10 & "text";
bad_calc2: Integer is "text" << 2;


// -----------------------------------------------------------------------------
// 【実験 4】メソッドの引数個数超過（Arity 超過）
// 期待される挙動: 引数の個数不一致エラー
// -----------------------------------------------------------------------------
10 println("余計な引数1", "余計な引数2");


// -----------------------------------------------------------------------------
// 【実験 5】戻り値型と return の不一致（明示的戻り値型の無視）
// 期待される挙動: 戻り値の型不一致エラー
// -----------------------------------------------------------------------------
bad_fn: Function(Integer; String) is [
    arg n: Integer;
    return 12345; // String を期待しているのに Integer を返している
];


// -----------------------------------------------------------------------------
// 【実験 6】高階関数の引数・戻り値シグネチャ不一致
// 期待される挙動: 要求された関数型と異なるブロックを渡したら弾かれる
// -----------------------------------------------------------------------------
run_callback: Function(Function(Integer; String);) is [
    arg cb: Function(Integer; String);
    cb(100) println;
];

// 引数が String の関数を渡してみる (Integer が要求されているのに String)
run_callback([ arg s: String; ret String; return s; ]);

return 0;
