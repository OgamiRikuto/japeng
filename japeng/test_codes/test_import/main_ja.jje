導入 "std/File";

"--- 1. 日本語ウィズによる自動クローズテスト ---" . 行出力;

ウィズ (ファイル型.作成("sample_ja.txt")) [
    引数 ファイル: ファイル型;
    ファイル.書く("日本語でファイルを書き込み");
    内容: 文字列型 = ファイル.読む;
    内容 .行出力;
];

ウィズ (ファイル型.開く("sample_ja.txt")) [
    引数 ファイル: ファイル型;
    データ: 文字列型 = ファイル.読む;
    ("読み込んだデータ: " + データ).行出力;
];

"--- 2. ウィズブロック終了 ---" .行出力;

返値 0;
