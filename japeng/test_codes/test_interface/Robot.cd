class Robot implements Speaker, Calculator:
    model: String;

    init: Function = [
        arg m: String;
        model = m;
    ];

    speak: Function = [
        "ピピピッ！ ロボット起動。".println;
    ];

    calc: Function = [
        arg a: Integer, b: Integer;
        ret Integer;
        return a * b + 10;
    ];
