a: Integer = 0;
add: Function = [
    arg n: Integer;
    ret Integer;
    a = 1;
    a.println;
    a += 1;
    a.println;

    return n + 1;
];
a.println;

add2: Function = [
    arg n: Integer, f: Function(Integer; Integer);
    ret Integer;
    return self.f(n);
];

self.add2(10, add);
a.println;

num: Num;
