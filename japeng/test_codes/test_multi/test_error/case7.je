// 呼び出し対象の高階関数
runner: Function(Function(Integer; String), Integer; String) is [
    arg cb: Function(Integer; String), val: Integer;
    ret String;
    return cb(val);
];

// [B-8] 正常系: 正しいシグネチャのコールバックを渡す
good_cb: Function(Integer; String) is [
    arg n: Integer;
    ret String;
    return "Num";
];
res: String is runner(good_cb, 10); // 正常通過！

// [B-9] エラー系: 引数の型が違うコールバックを渡す (String 期待の関数を渡す)
bad_arg_cb: Function(String; String) is [
    arg s: String;
    ret String;
    return s;
];
runner(bad_arg_cb, 10); // エラー！

// [B-10] エラー系: 戻り値の型が違うコールバックを渡す (String でなく Boolean を返す)
bad_ret_cb: Function(Integer; Boolean) is [
    arg n: Integer;
    ret Boolean;
    return true;
];
runner(bad_ret_cb, 10); // エラー！
