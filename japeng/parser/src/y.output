Terminals which are not used

   UNKNOWN
   "string"


Grammar

    0 $accept: program $end

    1 program: statement_list
    2        | class_def_list

    3 class_def_list: class_def
    4               | class_def_list class_def

    5 statement_list: statement
    6               | statement_list statement

    7 statement_list_opt: /* empty */
    8                   | statement_list

    9 statement: message ";"
   10          | multi_identifier ":" class ";"
   11          | multi_identifier ":" class "operator" expression_list ";"
   12          | multi_identifier "operator" expression_list ";"
   13          | identifier_decl ";"
   14          | return_stmt ";"
   15          | "break" ";"
   16          | "continue" ";"
   17          | error ";"

   18 class_def: class_decl ":" member_list

   19 message: receiver "identifier"
   20        | receiver "identifier" expression_list
   21        | receiver "operator" expression_list
   22        | "identifier" "(" expression_list_opt ")"
   23        | control_chain
   24        | message "." "identifier"
   25        | message "." "identifier" expression_list
   26        | message "." "operator" expression_list

   27 control_chain: "identifier" "(" expression_list_opt ")" block control_clause_list

   28 control_clause_list: /* empty */
   29                    | control_clause_list control_clause

   30 control_clause: "identifier" "(" expression_list_opt ")" block
   31               | "identifier" block

   32 class_decl: name_def
   33           | name_def "based" class
   34           | name_def "from" class_list

   35 name_def: "class" class

   36 class: "class name"
   37      | "class name" type_list
   38      | "..."
   39      | "class name" "(" type_list_comma_opt ";" type_list_comma_opt ")"
   40      | "(" class ")"

   41 type_item: "class name"
   42          | "(" class ")"

   43 type_list: type_item
   44          | type_list type_item

   45 type_list_comma: class
   46                | type_list_comma "," class

   47 type_list_comma_opt: /* empty */
   48                    | type_list_comma

   49 class_list: class
   50           | class_list "," class

   51 member_list: member
   52            | member_list member

   53 member: field_decl ";"
   54       | "static" field_decl ";"
   55       | message ";"
   56       | "static" message ";"
   57       | message "from" "class name" ";"
   58       | "static" message "from" "class name" ";"

   59 field_decl: identifier_decl
   60           | identifier_decl "from" "class name"

   61 identifier_decl: "identifier" ":" class
   62                | "operator" ":" class

   63 multi_identifier: "identifier" "," "identifier"
   64                 | multi_identifier "," "identifier"

   65 expression: primary
   66           | message

   67 primary: "identifier"
   68        | "self"
   69        | "integer"
   70        | "float"
   71        | "fraction"
   72        | "true"
   73        | "false"
   74        | "null"
   75        | BINARY
   76        | HEX
   77        | interpolated_string
   78        | block
   79        | "(" expression ")"
   80        | primary "[" expression "]"
   81        | "operator" primary

   82 interpolated_string: STR_OPEN string_parts STR_CLOSE

   83 string_parts: /* empty */
   84             | string_parts "string text"
   85             | string_parts "{" expression "}"

   86 block: "[" statement_list_opt "]"
   87      | "[" args ";" statement_list_opt "]"
   88      | "[" rets ";" statement_list_opt "]"
   89      | "[" args ";" rets ";" statement_list_opt "]"

   90 args: "arg" arg_decl_list

   91 arg_decl_list: arg_decl
   92              | arg_decl_list "," arg_decl

   93 arg_decl: "identifier" ":" class
   94         | "operator" ":" class
   95         | "identifier" ":" class "operator" expression

   96 rets: "ret" type_list_comma

   97 receiver: primary
   98         | identifier_decl
   99         | "class name"

  100 expression_list_opt: /* empty */
  101                    | expression_list

  102 expression_list: expression
  103                | expression_list "," expression

  104 return_stmt: "return" expression_list_opt


