class Fraction based Object:
    num: Integer;
    den: Integer;

    init: Function is [
        arg _num: Integer, _den: Integer;

        // 1. 最大公約数で約分
        g: Integer is _num gcd _den;
        n: Integer is _num / g;
        d: Integer is _den / g;

        // 2. 符号の正規化 (分母は常に正にする)
        if (d < 0) [
            d is 0 - d;
            n is 0 - n;
        ];

        num is n;
        den is d;
    ];

    +: Function is [
        arg other: Fraction;
        ret Fraction;
        _num: Integer is (num * other den) + (den * other num);
        _den: Integer is den * other den;
        return Fraction(_num, _den);
    ];

    -: Function is [
        arg other: Fraction;
        ret Fraction;
        _num: Integer is (num * other den) - (den * other num);
        _den: Integer is den * other den;
        return Fraction(_num, _den);
    ];

    *: Function is [
        arg other: Fraction;
        ret Fraction;
        return Fraction((num * other num), (den * other den));
    ];

    /: Function is [
        arg other: Fraction;
        ret Fraction;
        return self * other reciprocal;
    ];

    =: Function is [
        arg other: Fraction;
        ret Boolean;
        return (num = other num) and (den = other den);
    ];

    !=: Function is [
        arg other: Fraction;
        ret Boolean;
        return !(self = other);
    ];

    >: Function is [
        arg other: Fraction;
        ret Boolean;
        if (den = other den) [ return num > other num; ];
        return (num * other den) > (den * other num);
    ];

    <: Function is [
        arg other: Fraction;
        ret Boolean;
        if (den = other den) [ return num < other num; ];
        return (num * other den) < (den * other num);
    ];

    >=: Function is [
        arg other: Fraction;
        ret Boolean;
        return !(self < other);
    ];

    <=: Function is [
        arg other: Fraction;
        ret Boolean;
        return !(self > other);
    ];

    isPositive: Function is [
        ret Boolean;
        return num >= 0;
    ];

    toInteger: Function is [
        ret Integer;
        return num / den;
    ];

    isZero: Function is [
        ret Boolean;
        return num = 0;
    ];

    isInteger: Function is [
        ret Boolean;
        return den = 1;
    ];

    reciprocal: Function is [
        ret Fraction;
        return Fraction(den, num);
    ];

    pow: Function is [
        arg n: Integer;
        ret Fraction;
        return Fraction((num pow n), (den pow n));
    ];

    toString: Function is [
        ret String;
        if (den = 1) [
            return num toString;
        ];
        return (num toString) + "/" + (den toString);
    ];
