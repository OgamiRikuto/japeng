class Fraction based Object:
    num: Integer;
    den: Integer;

    init: Function = [
        arg _num: Integer, _den: Integer;

        // 1. 最大公約数で約分
        g: Integer = _num.gcd(_den);
        n: Integer = _num / g;
        d: Integer = _den / g;

        // 2. 符号の正規化 (分母は常に正にする)
        if (d < 0) [
            d = 0 - d;
            n = 0 - n;
        ];

        num = n;
        den = d;
    ];

    +: Function = [
        arg other: Fraction;
        ret Fraction;
        _num: Integer = (num * other.den) + (den * other.num);
        _den: Integer = den * other.den;
        return Fraction(_num, _den);
    ];

    -: Function = [
        arg other: Fraction;
        ret Fraction;
        _num: Integer = (num * other.den) - (den * other.num);
        _den: Integer = den * other.den;
        return Fraction(_num, _den);
    ];

    *: Function = [
        arg other: Fraction;
        ret Fraction;
        return Fraction(num * other.num, den * other.den);
    ];

    /: Function = [
        arg other: Fraction;
        ret Fraction;
        return self * other.reciprocal;
    ];

    ==: Function = [
        arg other: Fraction;
        ret Boolean;
        return (num == other.num) and (den == other.den);
    ];

    !=: Function = [
        arg other: Fraction;
        ret Boolean;
        return !(self == other);
    ];

    >: Function = [
        arg other: Fraction;
        ret Boolean;
        if (den == other.den) [ return num > other.num; ];
        return (num * other.den) > (den * other.num);
    ];

    <: Function = [
        arg other: Fraction;
        ret Boolean;
        if (den == other.den) [ return num < other.num; ];
        return (num * other.den) < (den * other.num);
    ];

    >=: Function = [
        arg other: Fraction;
        ret Boolean;
        return !(self < other);
    ];

    <=: Function = [
        arg other: Fraction;
        ret Boolean;
        return !(self > other);
    ];

    isPositive: Function = [
        ret Boolean;
        return num >= 0;
    ];

    toInteger: Function = [
        ret Integer;
        return num / den;
    ];

    isZero: Function = [
        ret Boolean;
        return num == 0;
    ];

    isInteger: Function = [
        ret Boolean;
        return den == 1;
    ];

    reciprocal: Function = [
        ret Fraction;
        return Fraction(den, num);
    ];

    pow: Function = [
        arg n: Integer;
        ret Fraction;
        return Fraction(num.pow(n), den.pow(n));
    ];

    toString: Function = [
        ret String;
        if (den == 1) [
            return num.toString;
        ];
        return (num.toString) + "/" + (den.toString);
    ];
