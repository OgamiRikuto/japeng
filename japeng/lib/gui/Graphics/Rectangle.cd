import "std/Math/Point";
import "gui/Graphics/Shape";

class Rectangle based Shape:
    pos: Point;
    width: Float;
    height: Float;
    cachedVertices: List<Point>;

    init: Function = [
        arg x: Float, y: Float, w: Float, h: Float, c: Integer = 16777215, isFilled: Boolean = true;
        super.init(c, isFilled);
        pos = Point(x, y);
        width = w;
        height = h;
        self.updateVertices;
    ];

    updateVertices: Function = [
        x: Float = pos.x;
        y: Float = pos.y;
        cachedVertices = L[
            Point(x, y),
            Point(x + width, y),
            Point(x + width, y + height),
            Point(x, y + height)
        ];
    ];

    move: Function = [
        arg dx: Float, dy: Float;
        pos.x = pos.x + dx;
        pos.y = pos.y + dy;
        self.updateVertices;
    ];

    moveTo: Function = [
        arg x: Float, y: Float;
        pos.x = x;
        pos.y = y;
        self.updateVertices;
    ];

    vertices: Function = [
        ret List<Point>;
        return cachedVertices;
    ];
