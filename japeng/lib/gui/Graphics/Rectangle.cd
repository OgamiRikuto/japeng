// lib/gui/Graphics/Rectangle.cd
import "gui/Window";
import "std/Math/Point";
import "gui/Graphics/Drawable";

class Rectangle based Object implements Drawable:
    pos: Point;
    width: Float;
    height: Float;
    color: Integer;

    init: Function = [
        arg x: Float, y: Float, w: Float, h: Float, c: Integer = 16777215;
        pos = Point(x, y);
        width = w;
        height = h;
        color = c;
    ];

    move: Function = [
        arg dx: Float, dy: Float;
        pos.move(dx, dy);
    ];

    moveTo: Function = [
        arg x: Float, y: Float;
        pos.change(x, y);
    ];

    setColor: Function = [
        arg c: Integer;
        color = c;
    ];

    draw: Function = [
        arg win: Window;
        win.fillRect(pos x, pos y, width, height, color);
    ];
