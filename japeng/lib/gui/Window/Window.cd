class Window based Object implements Close:
    ptr_hi: Integer;
    ptr_lo: Integer;

    init: Function = [
        arg width: Integer, height: Integer, title: String,
            resizable: Boolean = true, x: Integer = -1, y: Integer = -1;
    ];

    shouldClose: Function = [ ret Boolean; ];
    pollEvents:  Function = [];
    swapBuffers: Function = [];
    clear:       Function = [ arg color: Integer = 0; ];
    close:       Function = [];

    width:       Function = [ ret Integer; ];
    height:      Function = [ ret Integer; ];
    setSize:     Function = [ arg w: Integer, h: Integer; ];
    setPosition: Function = [ arg x: Integer, y: Integer; ];
    setTitle:    Function = [ arg title: String; ];

    // プリミティブ描画
    fillRect:    Function = [ arg x: Float, y: Float, w: Float, h: Float, color: Integer; ];
    drawRect:    Function = [ arg x: Integer, y: Integer, w: Integer, h: Integer, color: Integer; ];
    drawLine:    Function = [ arg x1: Float, y1: Float, x2: Float, y2: Float, color: Integer; ];
