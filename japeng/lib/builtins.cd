class Object:
    toString: Function is [ ret String; ];
    print: Function is [];
    println: Function is [];
    input: Function is [ arg prompt: String is ""; ret String; ];

class Integer based Object:
    pow: Function is [ arg n: Integer; ret Integer; ];
    gcd: Function is [ arg other: Integer; ret Integer; ];
    toString: Function is [ ret String; ];

class Float based Object:
    toString: Function is [ ret String; ];

class Decimal based Object:
    toString: Function is [ ret String; ];

class String based Object:
    get: Function is [ arg n: Integer; ret String; ];
    length: Function is [ ret Integer; ];
    split: Function is [ arg seq: String is " "; ret List String; ];
    trim: Function is [ ret String; ];
    toString: Function is [ ret String; ];

class Boolean based Object:
    toString: Function is [ ret String; ];

class List Type based Object:
    init: Function is [ arg ...; ];
    push: Function is [ arg val: Type; ];
    get: Function is [ arg index: Integer; ret Type; ];
    set: Function is [ arg index: Integer, val: Type; ];
    length: Function is [ ret Integer; ];
    swap: Function is [ arg index1:Integer, index2: Integer; ];
    map: Function is [ arg lambda: Function(Type; Auto); ret List Auto; ];
    toString: Function is [ ret String; ];
