class Random based Object:
    static seed: Function = [ arg _seed: Integer; ];
    static randint:   Function = [ arg min: Integer, max: Integer; ret Integer; ];
    static randfloat: Function = [ ret Float; ];

    static chance: Function = [
        arg probability: Float;
        ret Boolean;
        return Random.randfloat < probability;
    ];

    static shuffle: Function = [
        arg list: List Auto;
        i: Integer = list.length - 1;
        repeat (i > 0) [
            j: Integer = Random.randint(0, i);
            list.swap(i, j);
            i -= 1;
        ];
    ];

    static gaussian: Function = [ arg mean: Float, stdDev: Float; ret Float; ];
