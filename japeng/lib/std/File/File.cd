class File based Object implements Close:
    ptr_hi: Integer;
    ptr_lo: Integer;
    is_closed: Boolean;

    init:       Function = [ arg path: String, mode: String; ];    // path, mode ("r", "w", "a" 等)
    read_line:  Function = [ ret String; ];                        // 1行読み込み (EOFなら null または "")
    read_all:   Function = [ ret String; ];                        // 残りの全量を一括読み込み
    write:      Function = [ arg out: String; ret Boolean; ];      // 文字列を書き込み
    write_line: Function = [ arg out: String; ret Booleabn; ];     // 文字列 + 改行を書き込み
    is_eof:     Function = [ ret Boolean; ];                       // 終端に達したか (feof)
    close:      Function = [];                                     // ファイルを閉じる (fclose)

    static open: Function = [
        arg path: String; ret File;
        return File(path, "r");
    ];

    static create: Function = [
        arg path: String; ret File;
        return File(path, "w");
    ];

    static append: Function = [
        arg path: String; ret File;
        return File(path, "a");
    ];
