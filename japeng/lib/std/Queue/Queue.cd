class Queue Type based Object:
    queue: List Type;
    head: Integer = 0;
    tail: Integer = 0;
    count: Integer = 0;
    capacity: Integer = 16;

    init: Function = [
        arg initCapa: Integer;
        if (initCapa > 16) [ capacity = initCapa; ];
        queue = L[];
        capacity.repeat [ queue.push(null); ];
    ];

    push: Function = [
        arg item: Type;
        if (count == capacity) [ self.resize; ];
        queue[tail] = item;
        tail = (tail + 1) % capacity;
        count += 1;
    ];

    pop: Function = [
        ret Type;
        if (count == 0) [ return null; ];
        item: Type = queue[head];
        queue[head] = null;
        head = (head + 1) % capacity;
        count -= 1;
        return item;
    ];

    peek: Function = [
        arg offset: Integer;
        ret Type;
        if (offset < 0 or offset >= count) [
            return null;
        ];
        idx: Integer = (head + offset) % capacity;
        return queue[idx];
    ];

    length: Function = [
        ret Integer;
        return count;
    ];

    isEmpty: Function = [
        ret Boolean;
        return count == 0;
    ];

    resize: Function = [
        newCapa: Integer = capacity * 2;
        newQueue: List Type = L[];

        newCapa.repeat [ newQueue.push(null); ];
        count.repeat [
            arg i: Integer;
            newQueue[i] = queue[(head + i) % capacity];
        ];

        queue = newQueue;
        head = 0;
        tail = count;
        capacity = newCapa;
    ];
