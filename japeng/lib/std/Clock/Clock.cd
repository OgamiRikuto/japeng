class Clock based Object:
    lastTime: Float;

    init: Function = [
        lastTime = Clock.now;
    ];

    // リセットせずに経過秒数を返す (ベンチマーク用)
    elapsed: Function = [
        ret Float;
        return Clock.now - lastTime;
    ];

    // 経過秒数 (deltaTime) を返しつつ基準時刻をリセット (ゲームループ用)
    restart: Function = [
        ret Float;
        current: Float = Clock.now;
        dt: Float = current - lastTime;
        lastTime = current;
        return dt;
    ];

    // フレームレート制御 (例: 60FPSなら残り時間を自動 sleep して dt を返す)
    tick: Function = [
        arg fps: Float; // toFloatを実装後Integerに変更
        ret Float;
        target: Float = 1.0 / fps; // toFloat 実装後に(fps toFloatに変更)
        dt: Float = self.elapsed;
        if (dt < target) [
            Clock.sleep(target - dt);
        ];
        return self.restart;
    ];

    
    static now:   Function = [ ret Float; ];
    static sleep: Function = [ arg seconds: Float; ];
